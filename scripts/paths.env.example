# 复制成 paths.env 后按本机情况填一次；paths.env 已在 .gitignore 中，不会上传。
# 不填也能用：Agent 会按 references/04-render.md 里的探测命令自己定位。

export SKILL_DIR="$HOME/.workbuddy/skills/article-to-video"
export NODE_BIN="node"
export PY_BIN="python3"
export BB_VIDEO="$HOME/.workbuddy/skills/bb-video"
export RENDER="$BB_VIDEO/explainer/scripts/render.mjs"
export TTS="$BB_VIDEO/explainer/scripts/tts.py"
export QA="$SKILL_DIR/scripts/qa.mjs"
export OUTPUT_ROOT="$HOME/Documents/Creative Materials/Output/AI视频"

# 若使用托管版运行时，把 NODE_BIN / PY_BIN 换成绝对路径即可。
